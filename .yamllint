---
# yamllint settings (also compatible with ansible-lint)
extends: default

ignore: |
  broken/
  solutions/
  extras/
  .git/
  inventory/group_vars/all/vault.yml

rules:
  line-length:
    max: 160
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
