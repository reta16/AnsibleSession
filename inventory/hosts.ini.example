# Activity 1: copy this file to inventory/hosts.ini, then replace the IPs with
# your own (from ~/session6-ips.txt).
#
#   cp inventory/hosts.ini.example inventory/hosts.ini
#
# hosts.ini is in .gitignore: IP addresses are specific to YOUR servers,
# so they don't belong in the shared repo.

[web]
web1 ansible_host=WEB1_PUBLIC_IP
web2 ansible_host=WEB2_PUBLIC_IP
